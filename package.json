{
  "name": "dot",
  "version": "1.3.0",
  "private": true,
  "description": "Telegram bot for Ultimate Frisbee training notifications with seasonal scheduling",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=84 --test-coverage-branches=87 --test-coverage-functions=93 --test-coverage-include-all --test-coverage-include='src/**' --test-coverage-exclude='src/quiz/data/**' test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "check": "npm run type-check && npm run lint && knip",
    "verify": "npm run check && npm test",
    "mtproto:login": "tsx scripts/mtprotoLogin.ts",
    "docker:up": "docker compose up --build",
    "release": "npm version"
  },
  "keywords": [
    "telegram",
    "bot",
    "ultimate-frisbee",
    "scheduling",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "ollama": "^0.6.4",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "qrcode": "^1.5.4",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
