# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
CHAT_ID=your_chat_id_here                  # Team chat ID
CHAT_THREAD_ID=                            # Optional: Team chat thread ID
ADMIN_CHAT_ID=your_admin_chat_id_here     # Admin chat ID (for bot commands)
TRAINER_CHAT_ID=your_trainer_chat_id      # Trainer chat ID
TRAINER_CHAT_THREAD_ID=                    # Optional: Trainer chat thread ID
ENABLE_TRAINER_MESSAGES=true               # Enable/disable trainer messages (default: true)

# MTProto / User Account (REQUIRED - reading reactions is impossible with a bot token)
# 1. Go to https://my.telegram.org -> API development tools -> create an app
# 2. Put the api_id / api_hash below, then run: npm run mtproto:login
# 3. Paste the printed session string into TELEGRAM_SESSION
# The account MUST be a member of both CHAT_ID and TRAINER_CHAT_ID.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=                          # SECRET: full access to your account. Never commit or share.

# Attendance Configuration
WINTER_MIN_ATTENDANCE=8                    # Min 👍 on the training post, else remind then cancel
SUMMER_MIN_ATTENDANCE=8
REMINDER_HOURS_BEFORE=3                    # Remind the team this many hours before training
CANCEL_HOURS_BEFORE=1                      # Cancel (notify trainers) this many hours before training

# Ollama Configuration (optional - for AI-generated messages)
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MEMORY_LIMIT=5G                     # Maximum memory for Ollama container
OLLAMA_MEMORY_RESERVATION=4G               # Reserved memory for Ollama container

# Winter Season Configuration
WINTER_START_DATE=9:15                    # Format: month:day (September 15)
WINTER_LOCATION=Park Arena                # Default location for winter training
WINTER_PRACTICE_DAYS=2:20:30,6:21:00     # Format: day:time,day:time (Tuesday 20:30, Saturday 21:00)

# Summer Season Configuration
SUMMER_START_DATE=5:20                    # Format: month:day (May 20)
SUMMER_LOCATION=Beach Courts              # Default location for summer training
SUMMER_PRACTICE_DAYS=0:19:00,3:19:30     # Format: day:time,day:time (Sunday 19:00, Wednesday 19:30)

# Testing Configuration
TEST_MODE=false
OVERRIDE_DATE=                             # Example: 2024-01-15 or 2024-01-15T20:30:00 (ISO 8601 format)

# Exceptional Training Overrides (optional - overrides baseline training info)
EXCEPTIONAL_LOCATION=                      # If set, overrides baseline location for next training
EXCEPTIONAL_TIME=                          # Format: HH:MM (e.g., 18:30) - overrides baseline time
EXCEPTIONAL_CANCELLED=false                # Set to true to mark next training as cancelled

# Day Reference (for PRACTICE_DAYS):
# 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday
